# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Marca y contacto (públicas, se exponen al navegador) ---
# Nombre de marca (definido: Alero). Se deja configurable por si cambia la escritura o se agrega un sufijo.
NEXT_PUBLIC_BRAND_NAME="Alero"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp, correo e Instagram se configuran desde el panel: /admin → Ajustes del sitio.

# --- Correo (formulario de contacto y reservas) ---
# Si RESEND_API_KEY está vacío, los correos solo se registran en consola.
RESEND_API_KEY=""
EMAIL_FROM="Alero <hola@tudominio.com>"

# --- Base de datos y panel (Payload CMS) ---
DATABASE_URL="postgresql://alero:alero@localhost:5440/alero_web"
# Cadena aleatoria larga. Genera una con: openssl rand -hex 32
PAYLOAD_SECRET=""

# --- Imágenes en producción (Cloudflare R2 vía adaptador S3) ---
# En local déjalas vacías: las imágenes se guardan en la carpeta media/.
# En Netlify, con las cuatro primeras definidas, Payload sube las imágenes al bucket.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Endpoint de la cuenta de R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
# URL pública del bucket (Public Development URL de R2 o dominio propio), sin barra final.
S3_PUBLIC_URL=""
