# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL (local con Docker: ver docker-compose.yml)
DATABASE_URL="postgresql://alero:alero@localhost:5440/alero_web?schema=public"

# Zona horaria por defecto de la academia (IANA)
DEFAULT_TIMEZONE="America/Bogota"

# URL pública del sitio (usada en correos y metadatos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Correo transaccional (fase 2)
# RESEND_API_KEY=""
